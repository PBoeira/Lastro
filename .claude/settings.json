{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Edit(/financas/**)",
      "Edit(/tests/**)",
      "Edit(/*.cmd)",
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)",
      "Edit(/CLAUDE.md)",
      "Edit(/CLAUDE.local.md)",
      "Edit(/**/*.py)",
      "Edit(/config.local.json)",
      "Edit(/**/CLAUDE*.md)",
      "PowerShell(Copy-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Rename-Item *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(New-Item *)",
      "PowerShell(Set-Content *)",
      "PowerShell(Add-Content *)",
      "PowerShell(Out-File *)",
      "PowerShell(cp *)",
      "PowerShell(copy *)",
      "PowerShell(cpi *)",
      "PowerShell(mv *)",
      "PowerShell(move *)",
      "PowerShell(mi *)",
      "PowerShell(ren *)",
      "PowerShell(rni *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(erase *)",
      "PowerShell(rd *)",
      "PowerShell(rmdir *)",
      "PowerShell(ri *)",
      "PowerShell(ni *)",
      "PowerShell(md *)",
      "PowerShell(mkdir *)",
      "PowerShell(sc *)",
      "PowerShell(ac *)",
      "PowerShell(tee *)",
      "PowerShell(Tee-Object *)"
